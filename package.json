{
  "name": "booksy-receipt-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/extension/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "tsx packages/pdf-inspector/src/cli.ts",
    "spike:sample": "tsx scripts/make-spike-sample.ts",
    "build:extension": "pnpm --filter @brb/extension build",
    "gen:extension-key": "node scripts/gen-extension-key.mjs"
  },
  "devDependencies": {
    "@brb/booksy-parser": "workspace:*",
    "@brb/pdf-inspector": "workspace:*",
    "@brb/printer": "workspace:*",
    "@brb/receipt-renderer": "workspace:*",
    "@brb/shared": "workspace:*",
    "@brb/ticket-layout": "workspace:*",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
